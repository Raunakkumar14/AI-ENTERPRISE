# ══════════════════════════════════════════════════════════════
#  AI Knowledge Hub — Environment Variables Template
#  Copy this file to .env and fill in your real values.
#  NEVER commit .env to version control.
# ══════════════════════════════════════════════════════════════

# ──────────────────────────────────────────
# Application
# ──────────────────────────────────────────
APP_NAME="AI Knowledge Hub"
APP_VERSION="0.1.0"
# "development" | "staging" | "production"
ENVIRONMENT=development
DEBUG=true

# ──────────────────────────────────────────
# API
# ──────────────────────────────────────────
API_V1_PREFIX=/api/v1

# ──────────────────────────────────────────
# Authentication
# Generate a unique secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# ──────────────────────────────────────────
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ──────────────────────────────────────────
# Document ingestion and embeddings
# Gemini embeddings use the configured GEMINI_API_KEY.
# ──────────────────────────────────────────
MAX_DOCUMENT_SIZE_MB=10
MAX_EXTRACTED_TEXT_CHARS=5000000
DOCUMENT_CHUNK_SIZE=1200
DOCUMENT_CHUNK_OVERLAP=200
EMBEDDING_MODEL=models/gemini-embedding-001

# RAG answers use Gemini or Groq; keys are configured below.
RAG_LLM_PROVIDER=gemini
RAG_TOP_K=5
RAG_RELEVANCE_THRESHOLD=0.35
RAG_MAX_CONTEXT_CHARS=16000
RAG_IVFFLAT_PROBES=10

# ──────────────────────────────────────────
# Database — PostgreSQL + pgvector
# Format: postgresql+asyncpg://user:password@host:port/dbname
# ──────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://postgres:yourpassword@localhost:5432/knowledge_hub

# ──────────────────────────────────────────
# CORS — comma-separated list of allowed origins
# ──────────────────────────────────────────
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# ──────────────────────────────────────────
# AI / LLM Keys
# ──────────────────────────────────────────

# Groq — fast inference for open-source LLMs (LLaMA, Mixtral, Gemma…)
# Get yours at: https://console.groq.com/keys
GROQ_API_KEY=

# Default Groq model to use (can be overridden per request)
GROQ_MODEL=qwen/qwen3.8-27b

# Google Gemini — multimodal LLM (text, vision, audio)
# Get yours at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Default Gemini model to use
GEMINI_MODEL=gemini-2.5-flash
